# Copie para .env e preencha:  cp .env.example .env
# NUNCA suba o arquivo .env para o GitHub.

# Token do bot, gerado pelo @BotFather no Telegram
TELEGRAM_TOKEN=

# Seu ID numérico do Telegram. Deixe 0 na primeira vez e veja nos logs (ou pergunte ao @userinfobot)
TELEGRAM_USUARIO_PERMITIDO=0

# Chave da API do Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# Haiku 5.5 é o mais barato; troque por claude-sonnet-5-5 se quiser respostas mais caprichadas
ANTHROPIC_MODELO=claude-haiku-5-5

# Teto de tokens da resposta do modelo (não da pergunta). 1024 dá uns 700 palavras.
ANTHROPIC_MAX_TOKENS=1024

# Menor prefixo que o modelo aceita cachear, em tokens. O bloco fixo do system (a personalidade)
# só leva cache_control quando passa disso; abaixo, a API ignoraria o marcador em silêncio.
# Ajuste JUNTO com ANTHROPIC_MODELO:  Haiku 5.5 e Sonnet 5.5 = 512  |  Haiku 4.5 = 4096
ANTHROPIC_CACHE_MINIMO_TOKENS=512

# Arquivo com a personalidade do Jarvis (o system prompt fixo). Dentro do container é o volume
# ./config montado como somente leitura. Rodando no PC, aponte para config/personalidade.md.
# Se o arquivo faltar, o bot sobe com um texto mínimo de reserva e avisa no log.
JARVIS_PERSONALIDADE_ARQUIVO=/app/config/personalidade.md

NOME_USUARIO=Anderson
FUSO_HORARIO=America/Sao_Paulo

# Sites/APIs que o Jarvis pode checar. Formato: nome=url,nome2=url2
# Dica: se sua API tiver Spring Actuator, use o /actuator/health
SITES_MONITORADOS=agendabarber-api=https://api.barberagendaonline.com, agendabarber-api=https://api.barberagendaonline.com/actuator/health

# Cidade do clima (API Open-Meteo, sem chave). Pegue as coordenadas em qualquer mapa.
CLIMA_CIDADE=Curitiba
CLIMA_LATITUDE=-25.4284
CLIMA_LONGITUDE=-49.2733

# Feeds de notícias (RSS ou Atom). Formato: tema|url,tema|url
# O mesmo tema pode repetir para somar feeds, como "tecnologia" abaixo.
NOTICIAS_FEEDS=tecnologia|https://g1.globo.com/rss/g1/tecnologia/,tecnologia|https://feeds.arstechnica.com/arstechnica/index,politica|https://g1.globo.com/rss/g1/politica/

# ---- API da HUD (tela de briefing) ----
# Porta do servidor web. O docker-compose publica ela só em 127.0.0.1; o nginx faz o HTTPS.
JARVIS_PORTA=8090

# Token exigido em todos os endpoints, menos /api/saude. Gere um com:  openssl rand -hex 32
# Se ficar vazio, a API recusa TUDO com 401 (em dúvida, fecha).
HUD_TOKEN=

# Origens liberadas no CORS, separadas por vírgula. Vazio = nenhuma origem de navegador.
HUD_ORIGEM=https://jarvis-hud-gamma.vercel.app,http://localhost:4200

# Resumo de bom dia (segundo minuto hora dia mês dia-da-semana). Use - para desligar.
RESUMO_DIARIO_CRON=0 0 8 * * MON-FRI
