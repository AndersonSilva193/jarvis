<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>dev.jarvis</groupId>
    <artifactId>jarvis</artifactId>
    <version>0.1.0</version>
    <name>jarvis</name>
    <description>Assistente pessoal no Telegram com Claude, rodando em VPS</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Núcleo do Spring Boot: injeção de dependência, configuração, agendamento e logs. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Servidor web, só para a API da HUD (JARVIS_PORTA). O Telegram continua por long
             polling, sem depender de porta aberta nem de domínio. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Jackson 3 (padrão do Spring Boot 4) para montar e ler os JSONs das APIs -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Testes (versão vem do BOM do Boot); nada aqui entra no jar final. Traz o JUnit 5 que
             a maioria dos testes usa sozinho, e o Mockito/spring-test que o ContextoDaAplicacaoTest
             precisa para levantar o contexto sem abrir o poller do Telegram. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>jarvis</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
